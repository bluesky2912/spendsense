// SpendSense — Firestore Security Rules
//
// This file is a REFERENCE ONLY — Firestore doesn't read this file
// from your deployed site. You paste this text into:
// Firebase Console → your project → Firestore Database → Rules tab → Publish
//
// What this does: each signed-in user can read and write ONLY the
// single document that matches their own user ID. Nobody can read
// or write anyone else's data, and nobody who isn't signed in can
// touch anything at all.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
